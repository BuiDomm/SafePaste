{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Data Boundary",
  "version": "0.1.0-alpha.0",
  "identifier": "org.aiguard.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Data Boundary",
        "width": 1040,
        "height": 800,
        "minWidth": 720,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Inspect sensitive data before sending it to AI",
    "longDescription": "Local-first active scanner for prompts, files, and AI agent context.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
